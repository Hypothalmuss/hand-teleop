<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>diff_ik_controller</name>
  <version>0.1.0</version>
  <description>C++17 damped least-squares differential IK controller with nullspace posture, joint limits, latching e-stop and latency metrics.</description>
  <maintainer email="roboticai@eagleprojects.tn">robotic</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <build_depend>eigen</build_depend>

  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>hand_teleop_msgs</depend>
  <depend>ur5e_2f85_mujoco</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>mujoco_sim_ros</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

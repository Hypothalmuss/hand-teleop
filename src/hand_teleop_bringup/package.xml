<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hand_teleop_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, RViz config and shared config install for the hand teleop system.</description>
  <maintainer email="roboticai@eagleprojects.tn">robotic</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mujoco_sim_ros</exec_depend>
  <exec_depend>diff_ik_controller</exec_depend>
  <exec_depend>hand_tracker</exec_depend>
  <exec_depend>teleop_mapper</exec_depend>
  <exec_depend>teleop_console</exec_depend>

  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
